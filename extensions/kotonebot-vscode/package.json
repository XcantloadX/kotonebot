{
  "name": "kotonebot-vscode",
  "displayName": "Kotonebot Devtools",
  "description": "VS Code integration for kotonebot devtools diagnostics and server commands.",
  "version": "0.0.1",
  "publisher": "kotonebot",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:kotonebot.symbolsView",
    "onCommand:kotonebot.editor.open",
    "onCommand:kotonebot.editor.openSymbol",
    "onCommand:kotonebot.refreshDiagnostics",
    "onCommand:kotonebot.updateMetaIndex",
    "onCommand:kotonebot.renameDocumentPair",
    "onCommand:kotonebot.symbolTree.refresh",
    "onCommand:kotonebot.symbolTree.rename"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kotonebot",
      "properties": {
        "kotonebot.lspCommand": {
          "type": "string",
          "default": "kbot",
          "description": "Executable used to launch kotonebot devtools lsp."
        },
        "kotonebot.devtoolsServerHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host used by integrated kotonebot backend server (started by devtools-host)."
        },
        "kotonebot.devtoolsServerPort": {
          "type": "number",
          "default": 1178,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port used by integrated kotonebot backend server (started by devtools-host)."
        },
        "kotonebot.editorBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional editor page URL for webview. Empty means use devtoolsServerHost/devtoolsServerPort."
        },
        "kotonebot.autoRefreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update meta index when saving a *.png.json file."
        },
        "kotonebot.autoRefetchOnFsChanges": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refetch diagnostics when *.png.json files are created, changed, deleted, or renamed."
        },
        "kotonebot.autoPairRenameOnFileRename": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rename paired image/meta file when renaming or moving a *.png or *.png.json file."
        },
        "kotonebot.autoVariantRenameOnFileRename": {
          "type": "boolean",
          "default": true,
          "description": "When file name changes, automatically rename all related variant documents together (requires autoPairRenameOnFileRename)."
        },
        "kotonebot.autoRefreshDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "description": "Debounce delay in milliseconds for auto refetch triggered by file system changes."
        }
      }
    },
    "commands": [
      {
        "command": "kotonebot.refreshDiagnostics",
        "title": "Kotonebot: Refresh Diagnostics"
      },
      {
        "command": "kotonebot.updateMetaIndex",
        "title": "Kotonebot: Update Meta Index For Current File"
      },
      {
        "command": "kotonebot.renameDocumentPair",
        "title": "Kotonebot: Rename Document Pair"
      },
      {
        "command": "kotonebot.symbolTree.refresh",
        "title": "Refresh Symbol Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "kotonebot.symbolTree.rename",
        "title": "Rename Symbol"
      },
      {
        "command": "kotonebot.editor.open",
        "title": "Kotonebot: Open Editor"
      },
      {
        "command": "kotonebot.editor.openSymbol",
        "title": "Kotonebot: Open Symbol In Editor"
      }
    ],
    "views": {
      "kotonebot": [
        {
          "id": "kotonebot.symbolsView",
          "name": "Kotonebot Symbols"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kotonebot",
          "title": "Kotonebot",
          "icon": "media/kotonebot.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "kotonebot.editor.open"
        }
      ],
      "view/title": [
        {
          "command": "kotonebot.symbolTree.refresh",
          "when": "view == kotonebot.symbolsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kotonebot.symbolTree.rename",
          "when": "view == kotonebot.symbolsView && viewItem == kotonebot.symbol",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2"
  }
}
